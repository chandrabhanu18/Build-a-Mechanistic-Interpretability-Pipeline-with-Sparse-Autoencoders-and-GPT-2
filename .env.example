# Device Configuration (cpu, cuda, mps)
DEVICE=cpu

# Hugging Face & Model Cache Directories
HF_HOME=/root/.cache/huggingface
TRANSFORMERS_CACHE=/root/.cache/huggingface/hub

# Sparse Autoencoder Configuration
SAE_RELEASE=gpt2-small-res-jb
SAE_ID=blocks.8.hook_resid_pre
MODEL_NAME=gpt2-small

# Steering Intervention Parameters
DEFAULT_FEATURE_ID=14302
DEFAULT_STEERING_MULTIPLIER=50.0

# Batch & Generation Defaults
EXTRACTION_BATCH_SIZE=8
MAX_NEW_TOKENS=35
GENERATION_TEMPERATURE=0.7
